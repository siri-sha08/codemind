import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		// your code goes here
         int n;
         Scanner read = new Scanner(System.in);
         n = read.nextInt();
         while(n-->0){
             int a,b;
             a = read.nextInt();
             b = read.nextInt();
             if(a>b){
                 System.out.println(a);
             }
             else{
                 System.out.println(b);
             }
         }
	}
}
